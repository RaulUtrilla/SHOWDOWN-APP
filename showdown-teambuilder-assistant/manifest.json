{
  "manifest_version": 3,
  "name": "Showdown Teambuilder Assistant",
  "version": "1.0.0",
  "description": "Equipos de referencia para el Teambuilder de Pokémon Showdown. Cópialos o impórtalos con un clic, por formato.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Showdown Teambuilder Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["sidePanel", "storage", "clipboardWrite", "activeTab"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://play.pokemonshowdown.com/*"],
      "js": [
        "src/shared/teamparser.js",
        "src/shared/selectors.js",
        "src/content/teambuilder.content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
